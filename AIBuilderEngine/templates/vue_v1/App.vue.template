<template>
  <div v-if="site" class="min-h-screen flex flex-col font-sans transition-colors duration-300"
       :style="{ backgroundColor: site.palette?.background, color: site.palette?.text }">

    <Header
      v-if="site.header_type !== false"
      :businessName="site.business_name || 'Website'"
      :logoUrl="site.logo_url"
      :logoMode="site.logo_mode"
      :applyThemeColorToLogo="site.apply_theme_color_to_logo"
      :themeColor="site.palette?.primary"
      :palette="site.palette"
      :availableLanguages="availableLanguages"
      :currentLang="currentLang"
      @changeLang="changeLanguage"
      :contact="site.contact"
      @navigate="changePage"
      :t="t"
      :blocks="site.blocks || []"
      :hasCatalog="site.has_catalog"
    />

    <main v-if="currentPage === 'home'" class="flex-grow flex flex-col">
      <template v-for="(block, index) in site.blocks" :key="block.id || index">
        <div class="relative w-full">
          <component
            :is="resolveComponent(block.category, block.type)"
            :props="block.props || {}"
            :themeColor="site.palette?.primary"
            :palette="site.palette"
            :t="t"
            :animationsEnabled="site.animations_enabled !== false"
          />

          <div
              v-if="index < site.blocks.length - 1 && block.type !== 'HeroBlock' && block.type !== 'hero'"
              class="absolute bottom-0 left-0 w-full pointer-events-none px-6"
          >
            <div class="container mx-auto border-b-2"
                :style="{ borderColor: site.palette?.secondary, opacity: 0.1 }">
            </div>
          </div>
        </div>
      </template>
    </main>

    <main v-else-if="currentPage === 'privacy'" class="flex-grow pt-40 pb-24" :style="{ backgroundColor: site.palette?.background }">
       <div class="container mx-auto px-6 max-w-4xl">
         <h1 class="text-4xl md:text-6xl font-black mb-8 leading-tight" :style="{ color: site.palette?.primary }">
           {{ t('Privacy Policy') }}
         </h1>
         <div class="prose max-w-none" :style="{ color: site.palette?.text }" v-html="t('privacy_policy_text')"></div>
       </div>
    </main>

    <main v-else-if="currentPage === 'catalog'" class="flex-grow pt-32 pb-24" :style="{ backgroundColor: site.palette?.background }">
      <div class="container mx-auto px-6">
        <h1 class="text-4xl md:text-5xl font-black mb-12 text-center" :style="{ color: site.palette?.primary }">
           {{ t('Catalog') || 'Our Catalog' }}
        </h1>

        <div class="flex flex-col md:flex-row justify-between items-center gap-4 mb-10 max-w-4xl mx-auto">
          <div class="relative w-full md:w-2/3">
            <i class="fas fa-search absolute left-4 top-1/2 -translate-y-1/2 opacity-50"></i>
            <input v-model="searchQuery" type="text" :placeholder="t('search_placeholder') || 'Search products...'"
                   class="w-full py-3 pl-10 pr-4 rounded-xl border outline-none focus:ring-2 transition-all shadow-sm"
                   :style="{ borderColor: site.palette?.primary + '50', backgroundColor: site.palette?.background, color: site.palette?.text }">
          </div>
          <select v-model="selectedCategory"
                  class="w-full md:w-1/3 py-3 px-4 rounded-xl border outline-none focus:ring-2 transition-all shadow-sm cursor-pointer"
                  :style="{ borderColor: site.palette?.primary + '50', backgroundColor: site.palette?.background, color: site.palette?.text }">
            <option value="">{{ t('all_categories') || 'All Categories' }}</option>
            <option v-for="cat in productCategories" :key="cat" :value="cat">{{ cat }}</option>
          </select>
        </div>

        <div v-if="filteredProducts.length === 0" class="text-center py-20 opacity-50">
          <i class="fas fa-box-open text-6xl mb-4"></i>
          <h3 class="text-xl font-bold">{{ t('no_products_found') || 'No products found' }}</h3>
        </div>

        <div v-else class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
           <div v-for="item in filteredProducts" :key="item.id" class="rounded-3xl border overflow-hidden shadow-xl" :style="{ borderColor: site.palette?.primary + '30', backgroundColor: site.palette?.background }">

              <div v-if="item.images && item.images.length" class="relative w-full h-64 group bg-slate-100 overflow-hidden">
                <img :src="item.images[activeImage[item.id] || 0]" class="w-full h-full object-cover transition-all duration-500">
                <template v-if="item.images.length > 1">
                  <button @click.stop="prevImage(item)" class="absolute left-2 top-1/2 -translate-y-1/2 bg-black/30 hover:bg-black/60 text-white w-8 h-8 rounded-full flex items-center justify-center opacity-0 group-hover:opacity-100 transition-all shadow-sm backdrop-blur-sm z-10">
                    <i class="fas fa-chevron-left text-xs"></i>
                  </button>
                  <button @click.stop="nextImage(item)" class="absolute right-2 top-1/2 -translate-y-1/2 bg-black/30 hover:bg-black/60 text-white w-8 h-8 rounded-full flex items-center justify-center opacity-0 group-hover:opacity-100 transition-all shadow-sm backdrop-blur-sm z-10">
                    <i class="fas fa-chevron-right text-xs"></i>
                  </button>
                  <div class="absolute bottom-3 left-1/2 -translate-x-1/2 flex items-center gap-1.5 px-2 py-1 rounded-full bg-black/20 backdrop-blur-sm opacity-0 group-hover:opacity-100 transition-all">
                    <button v-for="(_, idx) in item.images" :key="idx"
                            @click.stop="activeImage[item.id] = idx"
                            class="rounded-full transition-all duration-300"
                            :class="(activeImage[item.id] || 0) === idx ? 'w-2 h-2 bg-white' : 'w-1.5 h-1.5 bg-white/50 hover:bg-white/90'">
                    </button>
                  </div>
                </template>
              </div>

              <div class="p-6">
                 <h3 class="text-2xl font-bold mb-3" :style="{ color: site.palette?.text }">{{ item.title }}</h3>
                 <p class="mb-6 opacity-80" :style="{ color: site.palette?.text }">{{ item.description }}</p>
                 <div class="flex items-center justify-between">
                    <span class="text-xl font-black" :style="{ color: site.palette?.primary }">${{ item.price }}</span>
                 </div>
              </div>
           </div>
        </div>
      </div>
    </main>

    <Footer
      v-if="site.footer_type !== false"
      :businessName="site.business_name"
      :logoUrl="site.logo_url"
      :logoMode="site.logo_mode"
      :applyThemeColorToLogo="site.apply_theme_color_to_logo"
      :themeColor="site.palette?.primary"
      :palette="site.palette"
      :contact="site.contact || {}"
      :t="t"
      @navigate="changePage"
    />

    <transition name="fade">
      <div v-if="showCookieBanner"
           class="fixed bottom-6 left-6 right-6 md:left-auto md:right-8 md:w-[400px] p-6 rounded-[2rem] shadow-2xl z-[100] border transition-colors duration-300"
           :style="{
             backgroundColor: site.palette?.background || '#ffffff',
             borderColor: site.palette?.primary + '30',
             color: site.palette?.text || '#1f2937'
           }">

        <h4 class="font-black text-xl mb-2" :style="{ color: site.palette?.primary }">
          {{ t('cookie_title') || 'Cookies & Privacy' }}
        </h4>

        <p class="text-sm mb-6 opacity-80 leading-relaxed">
          {{ t('cookie_text') || 'We use cookies to improve your experience and analyze site traffic. By continuing to use this site, you consent to our use of cookies.' }}
        </p>

        <div class="flex items-center gap-3">
          <button @click="acceptCookies"
                  class="flex-1 py-3 rounded-xl font-bold text-white shadow-md hover:shadow-lg transition-all"
                  :style="{ backgroundColor: site.palette?.primary }">
            {{ t('accept') || 'Accept All' }}
          </button>

          <button @click="rejectCookies"
                  class="flex-1 py-3 rounded-xl font-bold border transition-colors opacity-70 hover:opacity-100"
                  :style="{ borderColor: site.palette?.text + '40', color: site.palette?.text }">
            {{ t('reject') || 'Decline' }}
          </button>
        </div>
      </div>
    </transition>
  </div>
</template>

<script setup>
import { ref, onMounted, watch, computed } from 'vue'; // <-- Добавили computed

import Header from './components/Header.vue';
import Footer from './components/Footer.vue';

const blockModules = import.meta.glob('./components/blocks/*.vue', { eager: true });
const siteDataFiles = import.meta.glob('./site_*.json', { eager: true });

const site = ref(null);
const availableLanguages = ref({{ AVAILABLE_LANGUAGES_JSON }});

const savedLang = localStorage.getItem('selected_language');
const initialLang = savedLang && availableLanguages.value.includes(savedLang) ? savedLang : (availableLanguages.value[0] || 'en');
const currentLang = ref(initialLang);

const currentPage = ref('home');
const cookiesAccepted = ref(false);
const showCookieBanner = ref(false);

const searchQuery = ref('');
const selectedCategory = ref('');
const activeImage = ref({});

const nextImage = (item) => {
  const current = activeImage.value[item.id] || 0;
  activeImage.value[item.id] = (current + 1) % item.images.length;
};

const prevImage = (item) => {
  const current = activeImage.value[item.id] || 0;
  activeImage.value[item.id] = (current - 1 + item.images.length) % item.images.length;
};

const productCategories = computed(() => {
  if (!site.value || !site.value.products) return [];
  const cats = site.value.products.map(p => p.category).filter(Boolean);
  return [...new Set(cats)];
});

const filteredProducts = computed(() => {
  if (!site.value || !site.value.products) return [];
  let result = site.value.products;

  if (searchQuery.value) {
    const q = searchQuery.value.toLowerCase();
    result = result.filter(p =>
      (p.title && p.title.toLowerCase().includes(q)) ||
      (p.description && p.description.toLowerCase().includes(q))
    );
  }

  if (selectedCategory.value) {
    result = result.filter(p => p.category === selectedCategory.value);
  }

  return result;
});

const loadSiteData = (lang) => {
  try {
    const dataModule = siteDataFiles[`./site_${lang}.json`];
    if (!dataModule) throw new Error("JSON module not found");

    site.value = dataModule.default || dataModule;
    currentLang.value = lang;

    if (site.value?.seo) {
      // 1. Title
      document.title = site.value.seo.title || site.value.business_name || 'Website';

      // 2. Meta Description
      let metaDesc = document.querySelector('meta[name="description"]');
      if (!metaDesc) {
        metaDesc = document.createElement('meta');
        metaDesc.name = 'description';
        document.head.appendChild(metaDesc);
      }
      metaDesc.content = site.value.seo.description || '';

      // 3. Meta Keywords
      let metaKey = document.querySelector('meta[name="keywords"]');
      if (!metaKey) {
        metaKey = document.createElement('meta');
        metaKey.name = 'keywords';
        document.head.appendChild(metaKey);
      }
      metaKey.content = site.value.seo.keywords || '';
    } else {
      document.title = site.value?.business_name || 'Website';
    }

    window.PROJECT_ID = site.value?.id;

  } catch (error) {
    console.error(`Failed to load language: ${lang}`, error);
  }
};

watch(currentPage, (newPage) => {
  if (newPage === 'privacy' && site.value) {
    document.title = `${t('Privacy Policy')} | ${site.value.business_name}`;
  } else if (site.value) {
    document.title = site.value.business_name;
  }
});

const changeLanguage = (lang) => {
  localStorage.setItem('selected_language', lang);
  loadSiteData(lang);
};

const changePage = (pageName) => {
  currentPage.value = pageName;
  window.scrollTo({ top: 0, behavior: 'smooth' });
};

const acceptCookies = () => {
  cookiesAccepted.value = true;
  showCookieBanner.value = false;
  localStorage.setItem('cookies_accepted', 'true');
};

const rejectCookies = () => {
  cookiesAccepted.value = true;
  showCookieBanner.value = false;
  localStorage.setItem('cookies_accepted', 'false');
};

const t = (key, fallback = null) => {
  if (site.value && site.value.translations && site.value.translations[key]) {
    return site.value.translations[key];
  }
  return fallback || key;
};

onMounted(() => {
  loadSiteData(currentLang.value);
  const acc = localStorage.getItem('cookies_accepted');
  if (acc === 'true' || acc === 'false') {
    cookiesAccepted.value = true;
  } else {
    showCookieBanner.value = true;
  }
});

const resolveComponent = (category, type) => {
  if (!type) return blockModules['./components/blocks/HeroBlock.vue']?.default;

  let normalizedType = type;
  const tLower = type.toLowerCase();

  if (tLower.includes('faq')) normalizedType = 'FaqBlock';
  else if (tLower.includes('hero')) normalizedType = 'HeroBlock';
  else if (tLower.includes('about')) normalizedType = 'AboutBlock';
  else if (tLower.includes('features')) normalizedType = 'FeaturesBlock';
  else if (tLower.includes('contact')) normalizedType = 'ContactBlock';
  else if (tLower.includes('map')) normalizedType = 'MapBlock';
  else if (tLower.includes('form')) normalizedType = 'FormBlock';

  const path = `./components/blocks/${normalizedType}.vue`;
  return blockModules[path]?.default || blockModules['./components/blocks/HeroBlock.vue']?.default;
};
</script>

<style>
.fade-enter-active, .fade-leave-active { transition: opacity 0.5s ease; }
.fade-enter-from, .fade-leave-to { opacity: 0; }
</style>